# One-shot probe reports JSON to journald; require monitored alerts.
[Unit]
Description=OCAF cluster PostgreSQL operational health probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ocaf
Group=ocaf
Environment=OCAF_CLUSTER_PG_DSN_FILE=/etc/ocaf/pg-dsn
EnvironmentFile=/etc/ocaf/coordinator.env
ExecStart=/usr/local/bin/ocaf-cluster-health
TimeoutStartSec=12s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
