# Example only. Review paths, ownership and policy on the actual host.
# Do NOT treat this template as automatically deployed or audited.
[Unit]
Description=OCAF coordinator with signed WASIp1 sandbox hardening
Documentation=https://github.com/mojealterego/ocaf-runtime/blob/main/docs/STAGE_038_8_9_ACCEPTANCE.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ocaf
Group=ocaf
WorkingDirectory=/opt/ocaf
ExecStart=/opt/ocaf/bin/ocaf-coordinator
EnvironmentFile=/etc/ocaf/wasi.env

# Process descendants remain in the same systemd cgroup even when their
# immediate parent crashes or OCAF receives SIGKILL.
KillMode=control-group
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s
OOMPolicy=kill

# Host-level enforcement; Wasm fuel does not constrain native Wasmtime RSS.
CPUAccounting=yes
CPUQuota=200%
MemoryAccounting=yes
MemoryMax=1536M
MemorySwapMax=0
TasksAccounting=yes
TasksMax=128
LimitNOFILE=1024
LimitCORE=0

# The guest's private /tmp stage cannot reach the host's original /tmp.
PrivateTmp=yes
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# State directory is created automatically by systemd.
StateDirectory=ocaf
StateDirectoryMode=0700
ReadWritePaths=/var/lib/ocaf

# CA, tool publisher public-key and manifest files need independently
# reviewed effective-UID ownership and 0600 mode for wasi_config loader.
# Keep the executable installed under a root-administered, read-only tree.

[Install]
WantedBy=multi-user.target
