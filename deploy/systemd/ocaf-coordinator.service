# Install under /etc/systemd/system after reviewing all absolute paths.
# Environment file must contain only configuration, not secret values.
[Unit]
Description=OCAF PostgreSQL high-availability coordinator
Documentation=https://github.com/mojealterego/ocaf-runtime
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ocaf
Group=ocaf
Environment=OCAF_CLUSTER_MODE=postgres
Environment=OCAF_COORDINATOR_MODE=ha
Environment=OCAF_CLUSTER_PG_DSN_FILE=/etc/ocaf/pg-dsn
EnvironmentFile=/etc/ocaf/coordinator.env
ExecStart=/usr/local/bin/ocaf-coordinator
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=4096
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
