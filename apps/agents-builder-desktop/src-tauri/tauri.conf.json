{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCAF Agents Builder",
  "version": "0.1.0",
  "identifier": "org.ocaf.agentsbuilder",
  "build": {
    "frontendDist": "../../agents-builder-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OCAF Agents Builder",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://huggingface.co; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
