{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCAF Agents Builder",
  "version": "0.1.0",
  "identifier": "com.ocaf.agentsbuilder",
  "build": {
    "frontendDist": "../../agents-builder-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OCAF Agents Builder — Code / NoCode",
        "width": 1400,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://huggingface.co; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
