[Unit]
Description=OCAF OMAt Tool Server (example)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ocaf-omat --config /etc/ocaf/omat.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ocaf/omat
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure

[Install]
WantedBy=multi-user.target
